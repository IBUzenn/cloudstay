# =============================================================
# CloudStay — Root .env.example
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# This file controls docker-compose.yml variable substitution.
# NEVER commit a .env file with real credentials.
# =============================================================

# ── MySQL ─────────────────────────────────────────────────────
# Password used by both the MySQL container and the backend service
MYSQL_ROOT_PASSWORD=cloudstay_root_2024

# ── JWT Secrets ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_256_bit_random_string_before_production
JWT_REFRESH_SECRET=change_me_to_a_different_256_bit_random_string

JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Frontend API URL ──────────────────────────────────────────
# The browser (on the host machine) accesses the backend via localhost.
# Do NOT use "http://backend:5000" — Docker service names are not
# resolvable in the user's browser.
VITE_API_BASE_URL=http://localhost:5000/api

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── AWS S3 (optional — only required for receipt uploads) ─────
# Leave blank for local development without S3 functionality.
# The application will start without these; receipt upload will fail
# with a 500 error if no credentials are configured.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cloudstay-receipts
