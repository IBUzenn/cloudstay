# =============================================================
# CloudStay — Frontend Production Dockerfile
# Multi-stage: Vite build → Nginx static serving with API proxy
#
# VITE_API_BASE_URL=/api  — browser calls /api which Nginx proxies
# to the backend container at backend:5000.
#
# This Dockerfile is used ONLY for production (docker-compose.prod.yml).
# The original Dockerfile / nginx.conf remain unchanged for local dev.
# =============================================================

# ── Stage 1: Build ────────────────────────────────────────────
FROM node:18-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.js ./
COPY src ./src
COPY public ./public

# VITE_API_BASE_URL=/api — Nginx handles routing to backend container
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────────
FROM nginx:1.27-alpine

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Use production config that proxies /api to backend
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copy the Vite build output
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
