# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloudstay
DB_USER=root
DB_PASSWORD=your_db_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT
JWT_SECRET=change_this_to_a_256_bit_random_string
JWT_REFRESH_SECRET=change_this_to_another_256_bit_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AWS
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=cloudstay-receipts

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
