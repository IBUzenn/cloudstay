# Backend .dockerignore
# Prevents secrets, dev tools, and unnecessary files from being copied into the image

# Node modules (rebuilt inside Docker)
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# Environment secrets — NEVER copy into image
.env
.env.*

# Test files (not needed in production image)
tests
coverage
.nyc_output

# Git and editor files
.git
.gitignore
.gitkeep
.vscode
.idea

# Logs (mounted as volume or created at runtime)
logs

# Build artifacts
dist

# PM2 config (not used in Docker — CMD uses node directly)
ecosystem.config.js
